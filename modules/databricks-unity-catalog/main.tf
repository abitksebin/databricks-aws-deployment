# -----------------------------------------------------------------------------
# Unity Catalog module: metastore, its S3 storage, and the workspace assignment.
#
# What is created (unless existing_metastore_id is set):
#   - S3 bucket for the metastore root storage (managed tables, volumes).
#   - IAM role + policy that Unity Catalog assumes to read/write that bucket.
#   - The metastore, with the IAM role registered as its default credential.
# Always created:
#   - The assignment of the metastore to the workspace.
#
# This unit uses the account-level Databricks provider and needs different
# permissions from workspace configuration, which is why it is a separate unit.
# -----------------------------------------------------------------------------

data "aws_caller_identity" "current" {}

locals {
  create_metastore = var.existing_metastore_id == ""

  metastore_name   = coalesce(var.metastore_name, "${var.prefix}-${var.region}-metastore")
  bucket_name      = coalesce(var.metastore_bucket_name, "${var.prefix}-uc-${data.aws_caller_identity.current.account_id}")
  uc_role_name     = "${var.prefix}-uc-access"
  aws_account_id   = data.aws_caller_identity.current.account_id
  active_metastore = local.create_metastore ? databricks_metastore.this[0].id : var.existing_metastore_id
}

# -----------------------------------------------------------------------------
# Metastore root storage (S3)
# -----------------------------------------------------------------------------

resource "aws_s3_bucket" "metastore" {
  count = local.create_metastore ? 1 : 0

  bucket        = local.bucket_name
  force_destroy = var.force_destroy

  tags = {
    Name = local.bucket_name
  }
}

# Versioning protects managed table data against accidental deletes.
resource "aws_s3_bucket_versioning" "metastore" {
  count = local.create_metastore ? 1 : 0

  bucket = aws_s3_bucket.metastore[0].id

  versioning_configuration {
    status = "Enabled"
  }
}

resource "aws_s3_bucket_server_side_encryption_configuration" "metastore" {
  count = local.create_metastore ? 1 : 0

  bucket = aws_s3_bucket.metastore[0].id

  rule {
    apply_server_side_encryption_by_default {
      sse_algorithm = "AES256"
    }
  }
}

resource "aws_s3_bucket_public_access_block" "metastore" {
  count = local.create_metastore ? 1 : 0

  bucket = aws_s3_bucket.metastore[0].id

  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

# -----------------------------------------------------------------------------
# IAM role that Unity Catalog assumes to access the bucket
# -----------------------------------------------------------------------------

# Trust policy generated by the provider. It allows the Unity Catalog master
# role (with your account ID as external ID) to assume this role, and also lets
# the role assume itself, which Databricks requires ("self-assuming role").
# The role is referenced by name so there is no circular dependency on its ARN.
data "databricks_aws_unity_catalog_assume_role_policy" "this" {
  count = local.create_metastore ? 1 : 0

  aws_account_id = local.aws_account_id
  role_name      = local.uc_role_name
  external_id    = var.databricks_account_id
}

# Least-privilege permissions on the metastore bucket only.
data "databricks_aws_unity_catalog_policy" "this" {
  count = local.create_metastore ? 1 : 0

  aws_account_id = local.aws_account_id
  bucket_name    = aws_s3_bucket.metastore[0].id
  role_name      = local.uc_role_name
}

resource "aws_iam_role" "uc_access" {
  count = local.create_metastore ? 1 : 0

  name               = local.uc_role_name
  description        = "Assumed by Unity Catalog to access the metastore root bucket"
  assume_role_policy = data.databricks_aws_unity_catalog_assume_role_policy.this[0].json
}

resource "aws_iam_role_policy" "uc_access" {
  count = local.create_metastore ? 1 : 0

  name   = "${var.prefix}-uc-access-policy"
  role   = aws_iam_role.uc_access[0].id
  policy = data.databricks_aws_unity_catalog_policy.this[0].json
}

# IAM is eventually consistent. Without a short pause, registering the role as a
# credential can fail with a "cannot assume role" validation error.
resource "time_sleep" "iam_propagation" {
  count = local.create_metastore ? 1 : 0

  create_duration = "20s"

  depends_on = [aws_iam_role_policy.uc_access]
}

# -----------------------------------------------------------------------------
# Metastore
# -----------------------------------------------------------------------------

resource "databricks_metastore" "this" {
  count = local.create_metastore ? 1 : 0

  name          = local.metastore_name
  region        = var.region
  storage_root  = "s3://${aws_s3_bucket.metastore[0].id}/metastore"
  force_destroy = var.force_destroy

  depends_on = [
    aws_s3_bucket_public_access_block.metastore,
    time_sleep.iam_propagation,
  ]
}

# Register the IAM role as the metastore's default credential.
resource "databricks_metastore_data_access" "this" {
  count = local.create_metastore ? 1 : 0

  metastore_id = databricks_metastore.this[0].id
  name         = aws_iam_role.uc_access[0].name
  is_default   = true

  aws_iam_role {
    role_arn = aws_iam_role.uc_access[0].arn
  }
}

# -----------------------------------------------------------------------------
# Workspace assignment
# -----------------------------------------------------------------------------

resource "databricks_metastore_assignment" "this" {
  metastore_id = local.active_metastore
  workspace_id = var.workspace_id

  # When we create the metastore, wait for its default credential first so the
  # workspace never sees a metastore without storage access.
  depends_on = [databricks_metastore_data_access.this]
}
