# -----------------------------------------------------------------------------
# Workspace module: creates an AWS Databricks workspace in a customer-managed VPC.
#
# Databricks needs three things from your AWS account before it can create a
# workspace, plus the network:
#   1. Credentials      - a cross-account IAM role Databricks assumes to launch
#                         and manage cluster nodes.
#   2. Storage config   - an S3 root bucket for workspace system data.
#   3. Network          - the VPC, subnets and security group from the network
#                         module, registered with the Databricks account.
#
# Account-level resources use the account-level Databricks provider declared in
# versions.tf.
# -----------------------------------------------------------------------------

data "aws_caller_identity" "current" {}

locals {
  # Bucket names are global across AWS, so include the AWS account ID by default.
  root_bucket_name = coalesce(var.root_bucket_name, "${var.prefix}-root-${data.aws_caller_identity.current.account_id}")
  workspace_name   = coalesce(var.workspace_name, var.prefix)
}

# -----------------------------------------------------------------------------
# 1. Cross-account IAM role (credentials)
# -----------------------------------------------------------------------------

# Trust policy: lets the Databricks control plane assume the role, scoped by
# your Databricks account ID as the external ID (protects against the
# "confused deputy" problem).
data "databricks_aws_assume_role_policy" "this" {
  external_id = var.databricks_account_id
}

# Permissions policy generated by the provider. policy_type = "customer" is the
# variant for a customer-managed VPC (Databricks does not create network
# resources, so it needs fewer EC2 permissions).
data "databricks_aws_crossaccount_policy" "this" {
  policy_type = "customer"
}

resource "aws_iam_role" "cross_account" {
  name               = "${var.prefix}-crossaccount"
  description        = "Assumed by Databricks to manage cluster nodes in this account"
  assume_role_policy = data.databricks_aws_assume_role_policy.this.json
}

resource "aws_iam_role_policy" "cross_account" {
  name   = "${var.prefix}-crossaccount-policy"
  role   = aws_iam_role.cross_account.id
  policy = data.databricks_aws_crossaccount_policy.this.json
}

# IAM is eventually consistent: Databricks validates the role when the
# credentials object is created and can fail if the role has not propagated yet.
resource "time_sleep" "iam_propagation" {
  create_duration = "20s"

  depends_on = [aws_iam_role_policy.cross_account]
}

resource "databricks_mws_credentials" "this" {
  credentials_name = "${var.prefix}-credentials"
  role_arn         = aws_iam_role.cross_account.arn

  depends_on = [time_sleep.iam_propagation]
}

# -----------------------------------------------------------------------------
# 2. Root S3 bucket (storage configuration)
# -----------------------------------------------------------------------------

resource "aws_s3_bucket" "root" {
  bucket = local.root_bucket_name

  # Workspace root storage holds system data only (no business data), so it is
  # safe to let Terraform empty the bucket on destroy.
  force_destroy = true

  tags = {
    Name = local.root_bucket_name
  }
}

resource "aws_s3_bucket_server_side_encryption_configuration" "root" {
  bucket = aws_s3_bucket.root.id

  rule {
    apply_server_side_encryption_by_default {
      sse_algorithm = "AES256"
    }
  }
}

resource "aws_s3_bucket_public_access_block" "root" {
  bucket = aws_s3_bucket.root.id

  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

# Bucket policy granting the Databricks control plane access to the root bucket.
data "databricks_aws_bucket_policy" "root" {
  bucket = aws_s3_bucket.root.bucket
}

resource "aws_s3_bucket_policy" "root" {
  bucket = aws_s3_bucket.root.id
  policy = data.databricks_aws_bucket_policy.root.json

  # Public access must be blocked first, otherwise AWS can reject the policy.
  depends_on = [aws_s3_bucket_public_access_block.root]
}

resource "databricks_mws_storage_configurations" "this" {
  storage_configuration_name = "${var.prefix}-storage"
  bucket_name                = aws_s3_bucket.root.bucket

  depends_on = [aws_s3_bucket_policy.root]
}

# -----------------------------------------------------------------------------
# 3. Network registration
# -----------------------------------------------------------------------------

resource "databricks_mws_networks" "this" {
  network_name       = "${var.prefix}-network"
  vpc_id             = var.vpc_id
  subnet_ids         = var.subnet_ids
  security_group_ids = [var.security_group_id]
}

# -----------------------------------------------------------------------------
# The workspace
# -----------------------------------------------------------------------------

resource "databricks_mws_workspaces" "this" {
  workspace_name  = local.workspace_name
  deployment_name = var.deployment_name
  aws_region      = var.region

  credentials_id           = databricks_mws_credentials.this.credentials_id
  storage_configuration_id = databricks_mws_storage_configurations.this.storage_configuration_id
  network_id               = databricks_mws_networks.this.network_id

  # No `token` block on purpose: the workspace-config unit authenticates with
  # the same OAuth service principal instead of a long-lived personal access
  # token.
}
